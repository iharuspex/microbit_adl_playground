with "config/microbit_adl_playground_config.gpr";
with "microbit_bsp.gpr";

project Microbit_Adl_Playground is

   for Runtime ("ada") use Microbit_Bsp'Runtime ("Ada");
   for Target use "arm-eabi";
   for Languages use ("Ada");

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Microbit_Adl_Playground_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("microbit_adl_playground.adb");

   package Compiler is
      for Default_Switches ("Ada") use Microbit_Adl_Playground_Config.Ada_Compiler_Switches;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use
         Microbit_Bsp.Linker_Switches &
         ("-Wl,--print-memory-usage",
          "-Wl,--gc-sections",
          "-U__gnat_irq_trap");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Microbit_Adl_Playground;
